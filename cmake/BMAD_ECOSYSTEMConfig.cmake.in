@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Make BMAD_ECOSYSTEM-provided Find modules available to consumers:
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/modules")

# If consumer provides BMAD_EXTERNAL, treat it as a prefix for CONFIG packages too
set(BMAD_ECOSYSTEM_BUILT_WITH_BMAD_EXTERNAL "@BMAD_EXTERNAL@")

# Prefer consumer BMAD_EXTERNAL; otherwise fall back to the one used when building this package.
if(NOT DEFINED BMAD_EXTERNAL OR BMAD_EXTERNAL STREQUAL "")
  if(DEFINED BMAD_ECOSYSTEM_BUILT_WITH_BMAD_EXTERNAL AND NOT BMAD_ECOSYSTEM_BUILT_WITH_BMAD_EXTERNAL STREQUAL "")
    set(BMAD_EXTERNAL "${BMAD_ECOSYSTEM_BUILT_WITH_BMAD_EXTERNAL}")
  endif()
endif()

# If BMAD_EXTERNAL is known, use it as a prefix for dependency lookup.
if(DEFINED BMAD_EXTERNAL AND NOT BMAD_EXTERNAL STREQUAL "")
  list(PREPEND CMAKE_PREFIX_PATH "${BMAD_EXTERNAL}")
endif()

# Components requested by the consumer (may be empty)
set(_bmad_components "${BMAD_ECOSYSTEM_FIND_COMPONENTS}")

# ------------------------------------------------------------------
# IMPORTANT: If consumer did not request components, assume "bmad"
# so that dependency targets exist before BMAD_ECOSYSTEMTargets.cmake
# is included. This makes "find_package(BMAD_ECOSYSTEM)" just work.
# ------------------------------------------------------------------
if(NOT _bmad_components)
  set(_bmad_components bmad)
endif()

# ------------------------------------------------------------
# Component closure: higher-level components imply lower ones
# ------------------------------------------------------------
if("tao" IN_LIST _bmad_components)
  list(APPEND _bmad_components bmad sim_utils forest)
endif()

if("bmad" IN_LIST _bmad_components)
  list(APPEND _bmad_components sim_utils forest)
endif()

if("sim_utils" IN_LIST _bmad_components)
  list(APPEND _bmad_components forest)
endif()

if("cpp_bmad_interface" IN_LIST _bmad_components)
  list(APPEND _bmad_components bmad sim_utils forest)
endif()

if("bsim" IN_LIST _bmad_components)
  list(APPEND _bmad_components bmad sim_utils forest)
endif()

if("lux" IN_LIST _bmad_components)
  list(APPEND _bmad_components bmad sim_utils forest)
endif()

list(REMOVE_DUPLICATES _bmad_components)

# ------------------------------------------------------------
# External dependency loading
# (must happen BEFORE including BMAD_ECOSYSTEMTargets.cmake)
# ------------------------------------------------------------

# sim_utils external deps
if("sim_utils" IN_LIST _bmad_components)
  find_dependency(plplot CONFIG)
  find_dependency(FGSL)
  find_dependency(FFTW3)      # uses your FindFFTW3.cmake (module mode)
  find_dependency(LAPACK95)
endif()

# bmad external deps
if("bmad" IN_LIST _bmad_components)
  find_dependency(HDF5BMAD)
  find_dependency(XRAYLIB)
endif()

# Now import BMAD_ECOSYSTEM targets (they may refer to imported dep targets above)
include("${CMAKE_CURRENT_LIST_DIR}/BMAD_ECOSYSTEMTargets.cmake")

# Optional: error out if a requested component target isn't actually present
foreach(_c IN LISTS _bmad_components)
  if(NOT TARGET "BMAD_ECOSYSTEM::${_c}")
    set(BMAD_ECOSYSTEM_FOUND FALSE)
    set(BMAD_ECOSYSTEM_NOT_FOUND_MESSAGE
      "Requested component '${_c}' was not built/installed in this BMAD_ECOSYSTEM installation."
    )
    return()
  endif()
endforeach()
