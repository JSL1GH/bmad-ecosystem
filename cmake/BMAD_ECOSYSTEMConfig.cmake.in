#    set(_need_sim_utils_deps TRUE)
# endif()

  # sim_utils uses FGSL (and FGSL handles GSL version policy internally)
  if("sim_utils" IN_LIST _bmad_components)
#    find_dependency(FGSL)
#    find_dependency(PLPLOT)
     find_dependency(plplot CONFIG)
     find_dependency(FGSL)
#     find_dependency(FFTW3 CONFIG)
     find_dependency(FFTW3)
     find_dependency(LAPACK95)
  endif()

#  if("sim_utils" IN_LIST _bmad_components OR "bmad" IN_LIST _bmad_components)
#    find_dependency(plplot CONFIG)
#  endif()

  # Add more mappings as you export more components:
  if("tao" IN_LIST _bmad_components)
##    find_dependency(PLPLOT)
  endif()
  #
  if("bmad" IN_LIST _bmad_components)
    find_dependency(HDF5BMAD)
    find_dependency(XRAYLIB)
  endif()


#  if("bmad" IN_LIST _bmad_components)
#    find_dependency(LAPACK95)
#  endif()
  #
  # if("some_component" IN_LIST _bmad_components)
  #   find_dependency(FFTW3)
  # endif()

endif()

#JSL night - 1/11/26
#if(_need_sim_utils_deps)
#  find_dependency(FGSL)
#  find_dependency(FFTW3)     # NOT CONFIG (uses your FindFFTW3.cmake)
#  find_dependency(LAPACK95)
#  find_dependency(plplot CONFIG)  # if sim_utils really needs it
#endif()

include("${CMAKE_CURRENT_LIST_DIR}/BMAD_ECOSYSTEMTargets.cmake")

# Optional: error out if a requested component target isn't actually present
foreach(_c IN LISTS _bmad_components)
  if(NOT TARGET "BMAD_ECOSYSTEM::${_c}")
    set(BMAD_ECOSYSTEM_FOUND FALSE)
    set(BMAD_ECOSYSTEM_NOT_FOUND_MESSAGE "Requested component '${_c}' was not built/installed in this BMAD_ECOSYSTEM installation.")
    return()
  endif()
endforeach()
